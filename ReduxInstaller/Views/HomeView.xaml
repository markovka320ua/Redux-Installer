<UserControl x:Class="ReduxInstaller.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReduxInstaller.Views"
             xmlns:utilities="clr-namespace:ReduxInstaller.Utilities"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/App.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,48">
            <TextBlock Text="{utilities:Loc HomeTitle}" 
                       FontSize="42" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Margin="0,0,0,12"/>
            
            <TextBlock Text="{utilities:Loc HomeSubtitle}" 
                       FontSize="16" 
                       Foreground="{StaticResource SecondaryTextBrush}"
                       MaxWidth="600"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Main Action Card -->
            <Border Grid.Column="0" 
                    Style="{StaticResource Card}" 
                    MaxWidth="700"
                    VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <TextBlock Text="🎮" FontSize="48" Margin="0,0,20,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{utilities:Loc HomeCardTitle}" 
                                       FontSize="28" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Швидко та легко встановіть Redux мод для GTA V" 
                                       FontSize="14" 
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <TextBlock Text="{utilities:Loc HomeCardDescription}" 
                               FontSize="15" 
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,32"
                               LineHeight="24"/>

                    <Button Style="{StaticResource PrimaryButton}" 
                            HorizontalAlignment="Left"
                            Width="280"
                            Height="48"
                            FontSize="16"
                            Click="InstallButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬇️" FontSize="18" Margin="0,0,12,0"/>
                            <TextBlock Text="{utilities:Loc HomeInstallButton}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Status Card -->
            <Border Grid.Column="1" 
                    Style="{StaticResource Card}" 
                    Width="320"
                    Margin="32,0,0,0"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="📊" FontSize="32" Margin="0,0,0,16"/>
                    
                    <TextBlock Text="{utilities:Loc HomeGtaVStatus}" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="0,0,0,24"/>

                    <Border Background="#1A1A1A" 
                            CornerRadius="8" 
                            Padding="16,12"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="GtaVStatusText" 
                                       Text="{utilities:Loc HomeGtaVPathNotSet}" 
                                       FontSize="13" 
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,4"/>
                            
                            <TextBlock x:Name="GtaVPathText" 
                                       Text="" 
                                       FontSize="11" 
                                       Foreground="{StaticResource AccentBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource SecondaryButton}" 
                            Content="Змінити розташування"
                            Width="160"
                            Height="36"
                            HorizontalAlignment="Left"
                            Click="ChangeLocation_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>