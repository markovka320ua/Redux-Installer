<Window x:Class="ReduxInstaller.Views.NotificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReduxInstaller.Views"
        xmlns:utilities="clr-namespace:ReduxInstaller.Utilities"
        mc:Ignorable="d"
        Title="Notification" 
        Height="Auto" 
        Width="480"
        MinWidth="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/App.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Margin="14"
            Background="{StaticResource CardBrush}" 
            CornerRadius="16" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1"
            Padding="24"
            RenderTransformOrigin="0.5,0.5"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.75" BlurRadius="24" ShadowDepth="6"/>
        </Border.Effect>
        
        <StackPanel>
            <!-- Icon and Title Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBadgeBorder"
                        Grid.Column="0"
                        Background="{StaticResource AccentBadgeBg}"
                        CornerRadius="10"
                        Width="40" Height="40"
                        Margin="0,0,14,0"
                        VerticalAlignment="Top">
                    <Path x:Name="IconPath"
                          Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                          Fill="{StaticResource AccentHoverBrush}"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
                
                <TextBlock x:Name="TitleTextBlock" 
                           Grid.Column="1"
                           Text="Notification" 
                           FontSize="17" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryTextBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <Button Grid.Column="2"
                        Style="{StaticResource TitleBarCloseButton}"
                        Click="SecondaryButton_Click"
                        VerticalAlignment="Top">
                    <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" 
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                          StrokeThickness="1.5"
                          Width="10" Height="10"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
            
            <!-- Message Content -->
            <TextBlock x:Name="MessageTextBlock" 
                       Text="Message content goes here." 
                       FontSize="14" 
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,24"/>
            
            <!-- Buttons -->
            <StackPanel x:Name="ButtonsPanel" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton" 
                        Style="{StaticResource SecondaryButton}" 
                        Content="{utilities:Loc CommonCancel}"
                        MinWidth="100"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        Click="SecondaryButton_Click"/>

                <Button x:Name="PrimaryButton" 
                        Style="{StaticResource PrimaryButton}" 
                        Content="{utilities:Loc CommonOK}"
                        MinWidth="100"
                        Click="PrimaryButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>