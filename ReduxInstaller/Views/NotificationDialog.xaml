<Window x:Class="ReduxInstaller.Views.NotificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReduxInstaller.Views"
        xmlns:utilities="clr-namespace:ReduxInstaller.Utilities"
        mc:Ignorable="d"
        Title="Notification" 
        Height="Auto" 
        Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/App.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="NotificationButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Padding" Value="24,10"/>
                <Setter Property="Width" Value="120"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Notification Card -->
        <Border Background="#1C1C1C" 
                CornerRadius="16" 
                BorderBrush="#333333" 
                BorderThickness="1"
                Padding="32"
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="20" ShadowDepth="0"/>
            </Border.Effect>
            
            <StackPanel>
                <!-- Icon and Title -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock x:Name="IconTextBlock" 
                               Text="✓" 
                               FontSize="32" 
                               FontWeight="Bold"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    
                    <TextBlock x:Name="TitleTextBlock" 
                               Text="Success" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Message -->
                <TextBlock x:Name="MessageTextBlock" 
                           Text="Operation completed successfully" 
                           FontSize="14" 
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"/>
                
                <!-- Buttons -->
                <StackPanel x:Name="ButtonsPanel" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button x:Name="PrimaryButton" 
                            Style="{StaticResource NotificationButton}"
                            Content="OK"
                            Click="PrimaryButton_Click"/>
                    
                    <Button x:Name="SecondaryButton" 
                            Style="{StaticResource SecondaryButton}"
                            Content="Cancel"
                            Width="120"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Click="SecondaryButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>