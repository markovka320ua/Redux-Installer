<UserControl x:Class="ReduxInstaller.Views.ManageDownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReduxInstaller.Views"
             xmlns:utilities="clr-namespace:ReduxInstaller.Utilities"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/App.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,48">
            <TextBlock Text="{utilities:Loc download_manager}" 
                       FontSize="42" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Margin="0,0,0,12"/>
            
            <TextBlock Text="Переглядайте та керуйте історією завантажень" 
                       FontSize="16" 
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>

        <!-- Content -->
        <StackPanel Grid.Row="1" MaxWidth="700">
            <!-- Active Download Section -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,32" x:Name="ActiveDownloadCard" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <TextBlock Text="📥" FontSize="32" Margin="0,0,16,0"/>
                        <TextBlock Text="{utilities:Loc download_active}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="ActiveFileName" 
                               Text="Redux.zip" 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="0,0,0,16"/>

                    <ProgressBar x:Name="ActiveProgressBar" 
                                 Style="{StaticResource ModernProgressBar}"
                                 Margin="0,0,0,16"
                                 Height="8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <TextBlock x:Name="ActiveProgressText" 
                                   Text="0 / 0" 
                                   FontSize="15" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   Margin="0,0,24,0"/>

                        <TextBlock x:Name="ActiveSpeedText" 
                                   Text="" 
                                   FontSize="13" 
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,0,16,0"/>

                        <TextBlock x:Name="ActiveTimeText" 
                                   Text="" 
                                   FontSize="13" 
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" 
                                Content="{utilities:Loc download_pause}"
                                Width="120"
                                Height="40"
                                Margin="0,0,12,0"
                                Click="PauseButton_Click"/>

                        <Button Style="{StaticResource SecondaryButton}" 
                                Content="{utilities:Loc download_cancel}"
                                Width="120"
                                Height="40"
                                Click="CancelButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- History Section -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <TextBlock Text="📜" FontSize="32" Margin="0,0,16,0"/>
                        <TextBlock Text="{utilities:Loc download_history}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListBox x:Name="HistoryListBox" 
                             Background="Transparent"
                             BorderThickness="0"
                             Height="300"
                             Margin="0,0,0,16"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1A1A" 
                                        BorderBrush="#2A2A2A" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="16,12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding StatusIcon}" 
                                                   FontSize="20" 
                                                   Margin="0,0,16,0"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" 
                                                       FontSize="14" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding DateTimeString}" 
                                                       FontSize="12" 
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" 
                                                    Orientation="Horizontal" 
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileSizeString}" 
                                                       FontSize="12" 
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Margin="0,0,12,0"/>
                                            
                                            <Button Style="{StaticResource SecondaryButton}" 
                                                    Content="{utilities:Loc download_retry}"
                                                    Width="80"
                                                    Height="32"
                                                    FontSize="12"
                                                    Click="RetryButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Style="{StaticResource SecondaryButton}" 
                            Content="{utilities:Loc download_clear_history}"
                            HorizontalAlignment="Left"
                            Width="160"
                            Height="40"
                            Click="ClearHistory_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>