<UserControl x:Class="ReduxInstaller.Views.ManageDownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReduxInstaller.Views"
             xmlns:utilities="clr-namespace:ReduxInstaller.Utilities"
             xmlns:models="clr-namespace:ReduxInstaller.Models"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/App.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Text="{utilities:Loc download_manager}" 
                       FontSize="34" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Margin="0,0,0,8"/>
            
            <TextBlock Text="{utilities:Loc DownloadsSubtitle}" 
                       FontSize="15" 
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                <!-- Active Downloads Card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Background="{StaticResource AccentBadgeBg}"
                                        CornerRadius="10"
                                        Width="40" Height="40"
                                        Margin="0,0,14,0">
                                    <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"
                                          Fill="{StaticResource AccentHoverBrush}"
                                          Width="20" Height="20"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{utilities:Loc DownloadsActive}" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}" 
                                    Click="ClearHistory_Click"
                                    Padding="14,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="{utilities:Loc DownloadsClearHistory}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- List of active downloads -->
                        <ListBox x:Name="ActiveDownloadsListBox" 
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="False">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:DownloadTask">
                                    <Border Background="{StaticResource CardSecondaryBrush}" 
                                            BorderBrush="{StaticResource BorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="12" 
                                            Padding="20"
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" 
                                                               FontSize="15" 
                                                               FontWeight="Bold" 
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StatusText}" 
                                                               FontSize="12" 
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" 
                                                        Background="{StaticResource AccentBadgeBg}"
                                                        CornerRadius="6"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" 
                                                               FontSize="12" 
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource AccentHoverBrush}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Progress Bar -->
                                            <ProgressBar Grid.Row="1" 
                                                         Value="{Binding ProgressPercentage}" 
                                                         Maximum="100" 
                                                         Height="6" 
                                                         Margin="0,0,0,12"
                                                         Style="{StaticResource ModernProgressBar}"/>

                                            <!-- Speed, Size and Time -->
                                            <Grid Grid.Row="2" Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" 
                                                           FontSize="12" 
                                                           Foreground="{StaticResource SecondaryTextBrush}">
                                                    <Run Text="{Binding DownloadedSize}"/>
                                                    <Run Text=" / "/>
                                                    <Run Text="{Binding TotalSize}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding SpeedText}" 
                                                           FontSize="12" 
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" 
                                                           Text="{Binding TimeRemainingText}" 
                                                           FontSize="12" 
                                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                            </Grid>

                                            <!-- Actions -->
                                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                                <Button x:Name="CancelButton"
                                                        Style="{StaticResource DangerButton}"
                                                        Click="CancelButton_Click"
                                                        Padding="14,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              Width="10" Height="10"
                                                              Stretch="Uniform"
                                                              Margin="0,0,6,0"
                                                              VerticalAlignment="Center"/>
                                                        <TextBlock Text="{utilities:Loc download_cancel}" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                
                                                <Button x:Name="RetryButton"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Margin="8,0,0,0"
                                                        Click="RetryButton_Click"
                                                        Visibility="Collapsed"
                                                        Padding="14,6">
                                                    <TextBlock Text="{utilities:Loc download_retry}" FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty State Container -->
                        <Border x:Name="EmptyStateBorder"
                                Style="{StaticResource CardSubtle}"
                                Padding="32"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"
                                      Fill="{StaticResource MutedTextBrush}"
                                      Width="36" Height="36"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,12"/>
                                <TextBlock Text="{utilities:Loc download_empty}" 
                                           FontSize="14" 
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
