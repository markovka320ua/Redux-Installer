<UserControl x:Class="ReduxInstaller.Views.ManageDownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReduxInstaller.Views"
             xmlns:utilities="clr-namespace:ReduxInstaller.Utilities"
             xmlns:models="clr-namespace:ReduxInstaller.Models"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/App.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,48">
            <TextBlock Text="{utilities:Loc download_manager}" 
                       FontSize="42" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Margin="0,0,0,12"/>
            
            <TextBlock Text="Керуйте вашими завантаженнями" 
                       FontSize="16" 
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Active Downloads -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,32">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <TextBlock Text="⬇️" FontSize="32" Margin="0,0,16,0"/>
                            <TextBlock Text="Активні завантаження" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ListBox x:Name="ActiveDownloadsListBox" 
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="0,0,0,16"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:DownloadTask">
                                    <Border Background="#1A1A1A" 
                                            BorderBrush="#2A2A2A" 
                                            BorderThickness="1" 
                                            CornerRadius="12" 
                                            Padding="24"
                                            Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                                <TextBlock Text="{Binding StatusIcon}" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" 
                                                               FontSize="16" 
                                                               FontWeight="SemiBold" 
                                                               Foreground="{StaticResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="{Binding StatusText}" 
                                                               FontSize="12" 
                                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Progress -->
                                            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" 
                                                               Text="{Binding DownloadedSize}" 
                                                               FontSize="14" 
                                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    <TextBlock Grid.Column="1" 
                                                               Text="/" 
                                                               FontSize="14" 
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Margin="4,0,4,0"/>
                                                    <TextBlock Grid.Column="2" 
                                                               Text="{Binding TotalSize}" 
                                                               FontSize="14" 
                                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    <TextBlock Grid.Column="4" 
                                                               Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" 
                                                               FontSize="14" 
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding ProgressPercentage}" 
                                                           Maximum="100" 
                                                           Height="6" 
                                                           Style="{StaticResource ModernProgressBar}"/>
                                            </StackPanel>

                                            <!-- Speed and Time -->
                                            <Grid Grid.Row="2" Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" 
                                                           Text="{Binding SpeedText}" 
                                                           FontSize="13" 
                                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding TimeRemainingText}" 
                                                           FontSize="13" 
                                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                            </Grid>

                                            <!-- Actions -->
                                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                                <Button x:Name="CancelButton"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Content="Скасувати"
                                                        Height="36"
                                                        Click="CancelButton_Click"/>
                                                
                                                <Button x:Name="RetryButton"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Content="Повторити"
                                                        Height="36"
                                                        Margin="8,0,0,0"
                                                        Click="RetryButton_Click"
                                                        Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Clear History Button -->
                <Button Style="{StaticResource SecondaryButton}" 
                        Content="🗑 Очистити історію"
                        Height="40"
                        HorizontalAlignment="Left"
                        Click="ClearHistory_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
