<UserControl x:Class="ReduxInstaller.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReduxInstaller.Views"
             xmlns:utilities="clr-namespace:ReduxInstaller.Utilities"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/App.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,48">
            <TextBlock Text="{utilities:Loc SettingsTitle}" 
                       FontSize="42" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Margin="0,0,0,12"/>
            
            <TextBlock Text="Налаштуйте програму під ваші потреби" 
                       FontSize="16" 
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>

        <!-- Content -->
        <StackPanel Grid.Row="1" MaxWidth="700">
            <!-- GTA V Path Section -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,32">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <TextBlock Text="🎮" FontSize="32" Margin="0,0,16,0"/>
                        <TextBlock Text="{utilities:Loc SettingsGtaVPath}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" 
                                Background="#1A1A1A" 
                                BorderBrush="#2A2A2A" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="18,14"
                                Margin="0,0,12,0">
                            <TextBlock x:Name="GtaVPathText" 
                                       Text="Не налаштовано" 
                                       FontSize="14" 
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <Button Grid.Column="1" 
                                Style="{StaticResource SecondaryButton}" 
                                Content="{utilities:Loc SettingsChangePath}"
                                Width="140"
                                Height="40"
                                Click="ChangeGtaVPath_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Language Section -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,32">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <TextBlock Text="🌐" FontSize="32" Margin="0,0,16,0"/>
                        <TextBlock Text="{utilities:Loc SettingsLanguage}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <ComboBox x:Name="LanguageComboBox" 
                              Width="200" 
                              Height="40"
                              HorizontalAlignment="Left"
                              Style="{StaticResource CustomComboBox}"
                              ItemContainerStyle="{StaticResource CustomComboBoxItem}"
                              SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem Content="Українська" Tag="uk-UA"/>
                        <ComboBoxItem Content="English" Tag="en-US"/>
                        <ComboBoxItem Content="Русский" Tag="ru-RU" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Other Settings Section -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <TextBlock Text="⚙️" FontSize="32" Margin="0,0,16,0"/>
                        <TextBlock Text="Інше" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Style="{StaticResource SecondaryButton}" 
                            Content="📁 Відкрити папку"
                            HorizontalAlignment="Left"
                            Width="160"
                            Height="40"
                            Margin="0,0,0,12"
                            Click="OpenLogs_Click"/>

                    <Button Style="{StaticResource SecondaryButton}" 
                            Content="🗑 Очистити тимчасові"
                            HorizontalAlignment="Left"
                            Width="160"
                            Height="40"
                            Click="CleanTemp_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>