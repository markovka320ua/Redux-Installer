<UserControl x:Class="ReduxInstaller.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReduxInstaller.Views"
             xmlns:utilities="clr-namespace:ReduxInstaller.Utilities"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/App.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Text="{utilities:Loc AboutTitle}" 
                       FontSize="34" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Margin="0,0,0,8"/>
            
            <TextBlock Text="{utilities:Loc AboutSubtitle}" 
                       FontSize="15" 
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                <!-- About Card -->
                <Border Style="{StaticResource CardHighlight}" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- App Header Details -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource AccentBadgeBg}"
                                    CornerRadius="16"
                                    Width="56" Height="56"
                                    Margin="0,0,18,0">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                                      Fill="{StaticResource AccentHoverBrush}"
                                      Width="28" Height="28"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Redux Installer" 
                                               FontSize="24" 
                                               FontWeight="Bold" 
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Margin="0,0,12,0"/>
                                    
                                    <Border Background="{StaticResource AccentBadgeBg}"
                                            BorderBrush="#60E91E63"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="VersionBadge"
                                                   Text="v1.1.0" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   Foreground="{StaticResource AccentHoverBrush}"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="Grand Theft Auto V Mod Manager &amp; Installer" 
                                           FontSize="13" 
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>
                        
                        <TextBlock Text="{utilities:Loc AboutDescription}" 
                                   FontSize="14" 
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,28"
                                   LineHeight="22"/>

                        <!-- Divider -->
                        <Border Height="1" 
                                Background="{StaticResource BorderBrush}" 
                                Margin="0,0,0,24"/>

                        <!-- Developer Section -->
                        <StackPanel>
                            <TextBlock Text="{utilities:Loc about_developer}" 
                                       FontSize="15" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="@markovka320" 
                                       FontSize="14" 
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,16"/>

                            <Button Style="{StaticResource SecondaryButton}" 
                                    HorizontalAlignment="Left"
                                    Click="DeveloperButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.62 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.05-.49-.83-.27-1.49-.42-1.43-.88.03-.24.38-.49 1.03-.75 4.04-1.76 6.74-2.92 8.09-3.48 3.85-1.6 4.65-1.88 5.17-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.21-.04.38z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Telegram (@markovka320)" 
                                               FontSize="13" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Updates Card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Updates header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Background="{StaticResource AccentBadgeBg}"
                                    CornerRadius="10"
                                    Width="40" Height="40"
                                    Margin="0,0,14,0">
                                <Path Data="M21 10.12h-6.78l2.74-2.82c-2.73-2.7-7.15-2.8-9.88-.1-2.73 2.71-2.73 7.08 0 9.79 2.73 2.71 7.15 2.71 9.88 0C18.32 15.65 19 14.08 19 12.1h2c0 1.98-.88 4.55-2.64 6.29-3.51 3.48-9.21 3.48-12.72 0-3.5-3.47-3.53-9.11-.02-12.58 3.51-3.47 9.14-3.47 12.65 0L21 3v7.12zM12.5 8v4.25l3.5 2.08-.72 1.21L11 13V8h1.5z"
                                      Fill="{StaticResource AccentHoverBrush}"
                                      Width="20" Height="20"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{utilities:Loc AboutUpdatesTitle}" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Status area -->
                        <Border x:Name="UpdateStatusBorder"
                                Style="{StaticResource CardSubtle}"
                                Margin="0,0,0,16"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="UpdateStatusDot"
                                         Width="8" Height="8"
                                         Fill="{StaticResource SecondaryTextBrush}"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="UpdateStatusText"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Buttons row -->
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CheckUpdateButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="18,10"
                                    Click="CheckUpdateButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M21 10.12h-6.78l2.74-2.82c-2.73-2.7-7.15-2.8-9.88-.1-2.73 2.71-2.73 7.08 0 9.79 2.73 2.71 7.15 2.71 9.88 0C18.32 15.65 19 14.08 19 12.1h2c0 1.98-.88 4.55-2.64 6.29-3.51 3.48-9.21 3.48-12.72 0-3.5-3.47-3.53-9.11-.02-12.58 3.51-3.47 9.14-3.47 12.65 0L21 3v7.12zM12.5 8v4.25l3.5 2.08-.72 1.21L11 13V8h1.5z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CheckUpdateButtonText"
                                               Text="{utilities:Loc AboutCheckUpdates}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="DownloadUpdateButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="18,10"
                                    Margin="12,0,0,0"
                                    Visibility="Collapsed"
                                    Click="DownloadUpdateButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"
                                          Fill="White"
                                          Width="15" Height="15"
                                          Stretch="Uniform"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="{utilities:Loc AboutUpdateButton}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Download progress (hidden by default) -->
                            <Border x:Name="UpdateProgressBorder"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0"
                                    MinWidth="160">
                                <StackPanel>
                                    <ProgressBar x:Name="UpdateProgressBar"
                                                 Style="{StaticResource ModernProgressBar}"
                                                 Height="6"
                                                 Margin="0,0,0,4"/>
                                    <TextBlock x:Name="UpdateProgressText"
                                               Text="0%"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>