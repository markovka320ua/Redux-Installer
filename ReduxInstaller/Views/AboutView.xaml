<UserControl x:Class="ReduxInstaller.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReduxInstaller.Views"
             xmlns:utilities="clr-namespace:ReduxInstaller.Utilities"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/App.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Text="{utilities:Loc AboutTitle}" 
                       FontSize="34" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Margin="0,0,0,8"/>
            
            <TextBlock Text="{utilities:Loc AboutSubtitle}" 
                       FontSize="15" 
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                <!-- About Card -->
                <Border Style="{StaticResource CardHighlight}" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- App Header Details -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource AccentBadgeBg}"
                                    CornerRadius="16"
                                    Width="56" Height="56"
                                    Margin="0,0,18,0">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                                      Fill="{StaticResource AccentHoverBrush}"
                                      Width="28" Height="28"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Redux Installer" 
                                               FontSize="24" 
                                               FontWeight="Bold" 
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               Margin="0,0,12,0"/>
                                    
                                    <Border Background="{StaticResource AccentBadgeBg}"
                                            BorderBrush="#60E91E63"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="v1.0.11" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   Foreground="{StaticResource AccentHoverBrush}"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="Grand Theft Auto V Mod Manager &amp; Installer" 
                                           FontSize="13" 
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>
                        
                        <TextBlock Text="{utilities:Loc AboutDescription}" 
                                   FontSize="14" 
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,28"
                                   LineHeight="22"/>

                        <!-- Divider -->
                        <Border Height="1" 
                                Background="{StaticResource BorderBrush}" 
                                Margin="0,0,0,24"/>

                        <!-- Developer Section -->
                        <StackPanel>
                            <TextBlock Text="{utilities:Loc about_developer}" 
                                       FontSize="15" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="@markovka320" 
                                       FontSize="14" 
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,16"/>

                            <Button Style="{StaticResource SecondaryButton}" 
                                    HorizontalAlignment="Left"
                                    Click="DeveloperButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.62 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.05-.49-.83-.27-1.49-.42-1.43-.88.03-.24.38-.49 1.03-.75 4.04-1.76 6.74-2.92 8.09-3.48 3.85-1.6 4.65-1.88 5.17-1.89.11 0 .37.03.54.17.14.12.18.28.2.45-.02.07-.02.21-.04.38z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Telegram (@markovka320)" 
                                               FontSize="13" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>