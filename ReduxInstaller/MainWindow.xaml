<Window x:Class="ReduxInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReduxInstaller"
        xmlns:utilities="clr-namespace:ReduxInstaller.Utilities"
        mc:Ignorable="d"
        Title="Redux Installer" 
        Height="820" 
        Width="1280"
        MinHeight="680" 
        MinWidth="960"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="14"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/App.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Main Window Container with Rounded Border and Outer Shadow -->
    <Border Margin="6"
            CornerRadius="14"
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1"
            Background="{StaticResource BackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.6" BlurRadius="16" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" 
                  Background="{StaticResource TitleBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon & Title -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="18,0,0,0">
                    <!-- Glowing Dot -->
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#E91E63" BlurRadius="6" Opacity="0.8" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="REDUX" 
                               FontSize="13" 
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentHoverBrush}"/>
                    <TextBlock Text=" INSTALLER" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <!-- Minimize Button -->
                    <Button Width="36" 
                            Height="28" 
                            Style="{StaticResource TitleBarButton}"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M 0 5 L 10 5" 
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              StrokeThickness="1.5"
                              Width="10" Height="10"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <!-- Maximize/Restore Button -->
                    <Button x:Name="MaximizeBtn"
                            Width="36" 
                            Height="28" 
                            Style="{StaticResource TitleBarButton}"
                            Click="MaximizeButton_Click"
                            ToolTip="Maximize"
                            Margin="2,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="MaximizeIconPath"
                              Data="M 0 0 L 10 0 L 10 10 L 0 10 Z" 
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              StrokeThickness="1.2"
                              Fill="Transparent"
                              Width="10" Height="10"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <!-- Close Button -->
                    <Button Width="36" 
                            Height="28" 
                            Style="{StaticResource TitleBarCloseButton}"
                            Click="CloseButton_Click"
                            ToolTip="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" 
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              StrokeThickness="1.5"
                              Width="10" Height="10"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Layout: Sidebar + Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar Navigation -->
                <Border Grid.Column="0" 
                        Background="{StaticResource SidebarBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- App Brand Header -->
                        <StackPanel Grid.Row="0" Margin="20,20,20,16">
                            <Border Background="{StaticResource AccentBadgeBg}"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4-3c-.83 0-1.5-.67-1.5-1.5S18.67 9 19.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"
                                          Fill="{StaticResource AccentBrush}"
                                          Width="14" Height="14"
                                          Stretch="Uniform"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="GTA V MOD" 
                                               FontSize="11" 
                                               FontWeight="Bold" 
                                               Foreground="{StaticResource AccentHoverBrush}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Redux Installer" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="v1.1.0 Portable" 
                                       FontSize="12" 
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Nav Items -->
                        <StackPanel Grid.Row="1" Margin="8,8,8,0">
                            <!-- Home -->
                            <Button x:Name="HomeNavButton" 
                                    Style="{StaticResource NavButton}"
                                    Click="HomeNavButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" 
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="16" Height="16" 
                                          Stretch="Uniform"
                                          Margin="4,0,14,0"/>
                                    <TextBlock Text="{utilities:Loc NavHome}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Install -->
                            <Button x:Name="InstallNavButton" 
                                    Style="{StaticResource NavButton}"
                                    Click="InstallNavButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z" 
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="16" Height="16" 
                                          Stretch="Uniform"
                                          Margin="4,0,14,0"/>
                                    <TextBlock Text="{utilities:Loc NavInstall}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Download Manager (Conditional / Available) -->
                            <Button x:Name="DownloadManagerNavButton" 
                                    Style="{StaticResource NavButton}"
                                    Click="DownloadManagerNavButton_Click"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12zm-7-2h2v-4h3l-4-4-4 4h3z" 
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="16" Height="16" 
                                          Stretch="Uniform"
                                          Margin="4,0,14,0"/>
                                    <TextBlock Text="{utilities:Loc download_manager}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Settings -->
                            <Button x:Name="SettingsNavButton" 
                                    Style="{StaticResource NavButton}"
                                    Click="SettingsNavButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" 
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="16" Height="16" 
                                          Stretch="Uniform"
                                          Margin="4,0,14,0"/>
                                    <TextBlock Text="{utilities:Loc NavSettings}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- About -->
                            <Button x:Name="AboutNavButton" 
                                    Style="{StaticResource NavButton}"
                                    Click="AboutNavButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="16" Height="16" 
                                          Stretch="Uniform"
                                          Margin="4,0,14,0"/>
                                    <TextBlock Text="{utilities:Loc NavAbout}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Sidebar Footer -->
                        <Border Grid.Row="2" 
                                Margin="16,0,16,16" 
                                Padding="12,10"
                                Background="{StaticResource CardSecondaryBrush}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1">
                            <TextBlock Text="GTA V Redux Edition" 
                                       FontSize="11" 
                                       Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Dynamic Content Area -->
                <Border Grid.Column="1" 
                        Background="Transparent"
                        Padding="36,28,36,36">
                    <ContentControl x:Name="ContentArea" Focusable="False"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>